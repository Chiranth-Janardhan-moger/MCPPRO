# ==============================================================================
# MCPPRO Master Environment Configuration Template
# ==============================================================================
# This template outlines all configuration keys and secrets required across:
# 1. Frontend (Next.js 14 / Turbopack) -> frontend/.env.local
# 2. Backend (FastAPI / FastMCP)      -> backend/.env
# 3. GitHub Actions CI/CD             -> Repository Settings > Secrets and variables > Actions
# 4. Cloud Deployments                -> Render / Vercel / Supabase
#
# Rule: Never commit active .env or .env.local files containing real keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Authentication (Required for both Frontend and Backend)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ADMIN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Cross-Service Authentication & Endpoints
# ------------------------------------------------------------------------------
# Generate a secure 32+ character hex token:
# python -c "import secrets; print(secrets.token_hex(24))"
# Must match across backend and frontend!
BEARER_TOKEN=your-random-32-char-token-here
BACKEND_BEARER_TOKEN=your-random-32-char-token-here
MCP_SERVER_AUTH_TOKEN=your-random-32-char-token-here

# Backend service URL:
# Local development: http://127.0.0.1:8000
# Production deployment: https://your-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. AI Providers (LLMs & Multi-modal)
# ------------------------------------------------------------------------------
# At least one provider key is recommended for core agent and query processing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional search provider
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 4. Vector Database (Backend)
# ------------------------------------------------------------------------------
# DEFAULT_VECTOR_STORE: inmemory (default zero-config) | pinecone | qdrant | supabase
DEFAULT_VECTOR_STORE=inmemory
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Pinecone (Optional)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mcppro-documents
PINECONE_ENVIRONMENT=us-east-1

# Qdrant (Optional)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mcppro-documents

# ------------------------------------------------------------------------------
# 5. FastMCP Local Server
# ------------------------------------------------------------------------------
MCP_SERVER_PORT=8001
MCP_ENABLE_RAG=true
MCP_RAG_URL=http://127.0.0.1:8000/mcp
