# ==========================================
# Environment / Secret Configuration Files
# ==========================================
# Exclude all environment variables and local secret files
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
*.env.local
*.env.*
# Do NOT ignore template/example env files
!.env.example
!*.env.example
!env.example

