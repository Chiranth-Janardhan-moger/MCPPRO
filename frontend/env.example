# ==============================================================================
# MCPPRO Frontend Environment Variables
# Copy to frontend/.env.local for local development. Never commit .env.local.
# ==============================================================================

# --- Supabase (Required for Authentication, RLS & Chat History) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ADMIN="your-supabase-service-role-key"

# --- Backend API Connection ---
BACKEND_URL="http://127.0.0.1:8000"
BACKEND_BEARER_TOKEN="your-shared-bearer-token"
BEARER_TOKEN="your-shared-bearer-token"

# --- AI Provider Keys ---
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# --- External Tools ---
TAVILY_API_KEY=""
RESEND_API_KEY=""

# --- MCP Tooling ---
MCP_ENABLE_RAG="true"
MCP_RAG_URL="http://127.0.0.1:8000/mcp"
MCP_SERVER_AUTH_TOKEN="your-shared-bearer-token"
ENABLE_DANGEROUS_TOOLS="false"
