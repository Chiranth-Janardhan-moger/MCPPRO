# ============================================================================
# MCPPro Frontend — Environment Template
# Copy to .env.local and fill in values. Never commit the real .env.local.
# ============================================================================

# --- Supabase (required for auth + chat history) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only (signup emails, request logging)
SUPABASE_ADMIN=

# --- LLM Provider keys (server-only; enable models in the picker) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=      # or GEMINI_API_KEY
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# --- Resend (transactional email for signup OTP) ---
RESEND_API_KEY=

# --- Tavily (web search tool) ---
TAVILY_API_KEY=

# --- Backend integration ---
BACKEND_URL=http://127.0.0.1:8000
# Must match BEARER_TOKEN in backend/.env
BACKEND_BEARER_TOKEN=

# --- MCP servers (all optional; disabled during next build automatically) ---
MCP_ENABLE_RAG=true                # FastAPI MCP server on :8001
MCP_RAG_URL=http://127.0.0.1:8001/mcp
MCP_ENABLE_COMPUTER=false          # opt-in external computer-use server
MCP_COMPUTER_URL=http://127.0.0.1:8002/mcp
SMITHERY_API_KEY=                  # enables playwright MCP server
V0_BEARER_TOKEN=                   # enables v0 MCP server
# Full override: JSON array of {name, transport, url|command+args, enabled}
MCP_SERVERS_CONFIG=

# --- Safety ---
# DANGEROUS: enables arbitrary code-execution / SQL tools for the agent.
# Keep false in production unless you fully trust every signed-in user.
ENABLE_DANGEROUS_TOOLS=false
