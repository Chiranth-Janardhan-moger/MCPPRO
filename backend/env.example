# ============================================================================
# MCPPro Backend — Environment Template
# Copy to .env and fill in values. Never commit the real .env.
# ============================================================================

# --- Core ---
PROJECT_NAME="MCPPro Intelligence System"
ENVIRONMENT=development            # development | production
API_HOST=0.0.0.0
API_PORT=8000

# --- Authentication ---
# Shared secret for /mcppro-agent/* and /documents endpoints.
# Generate one:  python -c "import secrets; print(secrets.token_hex(24))"
BEARER_TOKEN=

# --- CORS ---
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Vector Store ---
# inmemory | qdrant | pinecone | supabase
DEFAULT_VECTOR_STORE=inmemory
EMBEDDING_MODEL=text-embedding-3-small   # requires OPENAI_API_KEY

# Pinecone (optional)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mcppro-documents
PINECONE_ENVIRONMENT=us-east-1

# Qdrant (optional)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mcppro-documents
QDRANT_PATH=
QDRANT_PREFER_GRPC=true

# --- LLM Providers ---
# openai | gemini | anthropic | groq | cerebras | openrouter | lmstudio
DEFAULT_LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash      # current stable Flash; see ai.google.dev

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# LM Studio / any OpenAI-compatible local server
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen/qwen3-4b
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Supabase (optional; request logging disabled when unset) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE_NAME=documents
SUPABASE_QUERY_NAME=match_documents
ENABLE_REQUEST_LOGGING=true

# --- Processing ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Caching ---
ENABLE_CACHING=true
CACHE_MIN_CHUNKS=0

# --- Agent ---
AGENT_ENABLED=true                 # default for /run when use_agent is omitted

# --- MCP Server (python run_mcp.py) ---
MCP_SERVER_PORT=8001
# When set, the MCP server requires Authorization: Bearer <token>.
MCP_SERVER_AUTH_TOKEN=
